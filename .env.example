# Root-level env for `docker compose` variable substitution only.
# Copy to `.env` and adjust. (.dockerignore keeps it out of the image.)
#
# WHY THESE MATTER
# These are BROWSER-facing: they get baked into the JavaScript served to the
# client, so they must be reachable from the user's machine.
#
# Keep the browser on `localhost` when running locally over plain HTTP. nest
# decides its auth-cookie flags from the request origin: same-site (localhost ->
# localhost) gives Secure=false/SameSite=Lax, which works over HTTP. Point the
# browser at a LAN IP instead and nest treats it as cross-site, issuing
# Secure=true/SameSite=None cookies — which browsers REJECT over plain HTTP,
# silently breaking sign-in with no visible error.
#
# Server-side rendering inside the frontend container uses a *separate*
# variable, INTERNAL_API_BASE (set in docker-compose.yml to http://nest:5001),
# because `localhost` there means the frontend container itself.
#
# On a real HTTPS deploy, set these to the public hostname (https://...), where
# Secure cookies are fine.

PUBLIC_API_BASE_URL=http://localhost:5001
PUBLIC_LIVEKIT_URL=ws://localhost:7880
PUBLIC_LIVEKIT_DEBUG=false

# nest refuses to boot in production while algojob_nest/.env still holds
# placeholder secrets ("change-me-in-production"). Set real secrets there before
# switching this to production.
NEST_NODE_ENV=development

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# How the CONTAINERS reach the natively-running LiveKit on this host.
# LiveKit runs outside Docker because it advertises a single ICE candidate IP,
# and under bridge networking no value works for both the browser and the
# in-Docker agent at once. Start it with ./start.sh (or
# livekit-local/run-livekit.sh).
# If agent-server cannot connect, set this to your LAN IP instead:
#   LIVEKIT_HOST=192.168.0.100
LIVEKIT_HOST=host.docker.internal
