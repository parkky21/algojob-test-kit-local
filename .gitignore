# Secrets. Every .env in this tree holds live credentials (Atlas, Neon, AWS,
# Razorpay, WhatsApp, LiveKit). .env.example is the committed template; real
# values come from the team's secret store — never from git.
.env
.env.local
**/.env
!.env.example

# Per-machine service selection (see services.conf.example / configure.sh) —
# not shared config, like .env.
/services.conf

# Runtime output from dev.sh / start.sh
logs/

# Not part of the deployed stack — large local scratch areas
staging/
analysis/
pypackages/
report/

# OS / editor
.DS_Store
**/.DS_Store
.idea/
.vscode/
